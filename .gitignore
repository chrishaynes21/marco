# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Claude Code local settings (per-machine)
.claude/

# Downloaded Vosk speech model (fetched by setup.ps1 -Voice, ~68MB)
plugins/voice/model/

# Downloaded artifacts fetched by setup.ps1 (onnxruntime zips, vision model weights)
_dl/
plugins/vision/models/

# User routes ignored
routes/

# Bundled Windows build (pack.ps1): staged embed assets + the packed exe
plugins/marco-app/assets/marco.exe
plugins/marco-app/assets/marco-macros.exe
plugins/marco-app/assets/overlay.exe
plugins/marco-app/assets/overlay.marco
plugins/marco-app/assets/version.txt
plugins/marco-app/assets/routes/
dist/